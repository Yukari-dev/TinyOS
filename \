#include "common.h"
#include "drivers/mouse.h"
#include "drivers/disk.h"
#include "memory/heap.h"
#include "fs/fs.h"
#include "vga/vga.h"
#include "ui/fonts/font.h"
#include "util/util.h"
#include "ui/windows/window.h"
#include "ui/image.h"

void main() {
    vga_init();
    heap_init();
    uint8_t buf[512];

    uint8_t* image_buffer = malloc(4096);
    disk_read(0, 100, 8, image_buffer);
    
    while(1) {
        vga_fill(0x222222);
        draw_bmp(100, 100, image_buffer);
        
        if(image_buffer){
            Font.draw_string(0, 0, "Image is loaded.", 0xFFFFFF);
        } else{
            Font.draw_string(0, 0, "Image couldn't load.", 0xFFFFFF);
        }

        vga_flip();
    }
}
